<!--
  HVGuard - lib/Shell.xaml
  WPF window loadable via XamlReader: NO x:Class, NO code-behind, NO inline event handlers.
  All event wiring and text (i18n) is done from code, from HVGuard.ps1 / the modules.
  Named elements that the rest of the code expects to find (FindName):
    MainTabs (TabControl) + 5 Grid: PanelStatus, PanelRepair, PanelHarden, PanelFolder, PanelScanner
    StatusLight (Ellipse), StatusText (TextBlock), StatusHint (TextBlock)
    DetailsExpander (Expander) -> DetailsContent (ItemsControl)
    LangSelector (ComboBox), AppTitle, AppSubtitle, LangLabel, StatusBar,
    TabStatus/TabRepair/TabHarden/TabFolder/TabScanner (to set their headers via i18n)
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HVGuard"
        Width="880" Height="660" MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="#F3F4F6">

    <Window.Resources>
        <SolidColorBrush x:Key="HeaderBrush"    Color="#1F2A44"/>
        <SolidColorBrush x:Key="HeaderTextDim"  Color="#C7D2FE"/>
        <SolidColorBrush x:Key="CardBrush"      Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder"     Color="#D1D5DB"/>
        <SolidColorBrush x:Key="MutedText"      Color="#6B7280"/>
        <SolidColorBrush x:Key="StatusBarBrush" Color="#E5E7EB"/>

        <!-- Large action button (verbs: Check, Repair...) -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: header -->
            <RowDefinition Height="Auto"/>   <!-- 1: status light + details -->
            <RowDefinition Height="*"/>      <!-- 2: tabs -->
            <RowDefinition Height="Auto"/>   <!-- 3: status bar -->
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <Grid Grid.Row="0" Background="{StaticResource HeaderBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="18,12">
                <TextBlock x:Name="AppTitle" Text="HVGuard" FontSize="21" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="AppSubtitle" Text="Protect your PC" FontSize="12"
                           Foreground="{StaticResource HeaderTextDim}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock x:Name="LangLabel" Text="Language" Foreground="White"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="LangSelector" Width="130" VerticalAlignment="Center">
                    <ComboBoxItem Content="Espanol" Tag="es"/>
                    <ComboBoxItem Content="English" Tag="en"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- ================= Status light + details ================= -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="18,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Grid VerticalAlignment="Center" Margin="0,0,16,0">
                        <Ellipse x:Name="StatusLight" Width="34" Height="34" Fill="#9AA0A6"
                                 Stroke="#00000022" StrokeThickness="1"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Text="Not checked" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusHint" Style="{StaticResource Muted}" FontSize="12"
                                   Text="Click Check to review your PC state." MaxWidth="720"/>
                    </StackPanel>
                </StackPanel>
                <Expander x:Name="DetailsExpander" Header="View details" Margin="0,10,0,0" IsExpanded="False">
                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                        <ItemsControl x:Name="DetailsContent"/>
                    </ScrollViewer>
                </Expander>
            </StackPanel>
        </Border>

        <!-- ================= Tabs (one per module) ================= -->
        <TabControl x:Name="MainTabs" Grid.Row="2" Margin="10,10,10,6" BorderThickness="0" Background="Transparent">
            <TabItem x:Name="TabStatus"  Header="Check">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6,6,12,6">
                    <Grid x:Name="PanelStatus"/>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="TabRepair"  Header="Repair">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6,6,12,6">
                    <Grid x:Name="PanelRepair"/>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="TabHarden"  Header="Harden">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6,6,12,6">
                    <Grid x:Name="PanelHarden"/>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="TabFolder"  Header="Game folder">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6,6,12,6">
                    <Grid x:Name="PanelFolder"/>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="TabScanner" Header="Scanner">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6,6,12,6">
                    <Grid x:Name="PanelScanner"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ================= Status bar ================= -->
        <Border Grid.Row="3" Background="{StaticResource StatusBarBrush}">
            <TextBlock x:Name="StatusBar" Margin="12,5" Foreground="#374151"
                       Text="Ready." TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
